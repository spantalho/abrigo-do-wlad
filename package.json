{
  "name": "abrigo-do-wlad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cron": "wrangler dev --config workers/cron/wrangler.jsonc --test-scheduled",
    "build": "npm run build:app",
    "build:app": "tsc -b && vite build",
    "build:cron": "wrangler deploy --dry-run --config workers/cron/wrangler.jsonc --outdir .wrangler/cron-check",
    "check:cron": "npm run build:cron",
    "test": "npm run test:unit && npm run test:frontend && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:frontend": "vitest run --config vitest.config.ts --project frontend --passWithNoTests",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck:worker": "tsc --noEmit -p tests/worker/tsconfig.json",
    "test:e2e": "playwright test --project=chromium --pass-with-no-tests",
    "test:e2e:all": "playwright test --pass-with-no-tests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build:app && wrangler deploy",
    "deploy:cron": "wrangler deploy --config workers/cron/wrangler.jsonc"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "jose": "^6.2.9",
    "lucide-react": "^0.562.0",
    "motion": "^12.34.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.12.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "msw": "^2.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
